                        <div class="wheel-halo wheel-halo--2"></div>
                        <div class="wheel-orbit"></div>
                        <div class="wheel-track"></div>
                        <div class="wheel-rotor" id="wheel-rotor">
                            <% aboutItems.forEach(function(it, i){ %><span class="wheel-spoke" style="--a:<%= i * 360 / aboutItems.length %>deg"></span><% }) %>
                        </div>
                        <span class="wheel-marker"></span>
                        <div class="wheel-hub">
                            <button type="button" class="wheel-toggle" id="wheel-toggle" aria-label="Pause animation">
                                <svg class="i-pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                                <svg class="i-play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                            </button>
                        </div>
                        <% aboutItems.forEach(function(it, i){ %>
                            <button type="button" class="wheel-icon" data-index="<%= i %>" aria-label="<%= it.name %>">
                                <img src="./images/logos/<%= it.logo %>" alt="<%= it.name %>">
                            </button>
                        <% }) %>
                    </div>
                    <p class="wheel-hint">Click a logo to explore</p>
                    <div class="timeline" aria-label="Timeline">
                        <div class="tl-track">
                            <% aboutItems.forEach(function(it, i){ var end = it.end === null ? nowY : it.end; %>
                                <button type="button" class="tl-bar tl-bar--<%= it.lane %>" data-index="<%= i %>" style="left:<%= pct(it.start) %>%;width:<%= (pct(end) - pct(it.start)).toFixed(2) %>%" title="<%= it.name %> · <%= it.period %>" aria-label="<%= it.name %>, <%= it.period %>"></button>
                            <% }) %>
                        </div>
                        <div class="tl-axis">
                            <% for (var y = axisStart; y <= axisEnd; y += 2) { %><span style="left:<%= pct(y) %>%"><%= y %></span><% } %>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 d-flex flex-column justify-content-center px-lg-5">
                    <h1 class="about-heading border-bottom">My Journey</h1>
                    <div class="about-panels" id="about-panels" aria-live="polite">
                        <% aboutItems.forEach(function(it, i){ %>
                            <article class="about-panel<%= i === 0 ? ' is-active' : '' %>" data-index="<%= i %>">
                                <div class="about-top">
                                    <div>
                                        <span class="about-kicker"><%= it.kind %></span>
                                        <h2 class="about-title"><%= it.name %></h2>
                                        <p class="about-meta"><%= it.role %></p>
                                    </div>
                                    <span class="about-period"><%= it.period %></span>
                                </div>
                                <% it.body.forEach(function(t){ %><p class="text-start"><%= t %></p><% }) %>
                                <ul class="about-stats">
