<section id="about-me" class="about-section min-vh-100 d-flex align-items-center">
    <div class="about-bg" aria-hidden="true">
        <% [[8,12,26,0],[22,78,14,-4],[40,6,18,-9],[62,90,22,-2],[80,18,12,-6],[90,70,16,-11],[14,46,10,-7],[70,48,12,-3]].forEach(function(d){ %>
