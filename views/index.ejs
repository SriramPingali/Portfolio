<script>
    document.addEventListener("DOMContentLoaded", function() {
        const typewriterText = document.getElementById("typewriter-text");
        const roles = ["Strategy & Operations", "Management Consultant", "Business Analyst", "Product Manager", "AI Engineer", "Full Stack Developer"];
        let currentPhraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;

        function type() {
            if (charIndex < roles[currentPhraseIndex].length) {
                typewriterText.textContent += roles[currentPhraseIndex][charIndex];
                charIndex++;
                setTimeout(type, 70);
            } else {
                isDeleting = true;
                setTimeout(deleteText, 1300);
            }
        }

        function deleteText() {
            if (charIndex > 0) {
                typewriterText.textContent = roles[currentPhraseIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(deleteText, 50);
            } else {
                isDeleting = false;
                currentPhraseIndex = (currentPhraseIndex + 1) % roles.length;
                setTimeout(type, 500);
            }
        }

        type();
    });
</script>

<script>
    (function () {
        const wheel = document.getElementById("wheel");
        if (!wheel) return;
        const icons = Array.from(wheel.querySelectorAll(".wheel-icon"));
        const panels = Array.from(document.querySelectorAll(".about-panel"));
        const rotor = document.getElementById("wheel-rotor");
        const toggle = document.getElementById("wheel-toggle");
        const bars = Array.from(document.querySelectorAll(".tl-bar"));
        const N = icons.length, STEP = 360 / N, INTERVAL = 4500;
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let rot = 0;        // total wheel rotation in degrees (kept unbounded so transitions never jump)
        let active = 0;     // index of the icon sitting at 3 o'clock
        let playing = !reduceMotion;
        let timer = null;

        function render() {
            icons.forEach(function (el, i) {
                const a = i * STEP + rot;
                const on = i === active;
                // spin out to the rim, then counter-rotate so the logo stays upright
                el.style.transform = "rotate(" + a + "deg) translateX(var(--r)) rotate(" + -a + "deg) scale(" + (on ? 1.3 : 1) + ")";
                el.classList.toggle("is-active", on);
                el.setAttribute("aria-current", on ? "true" : "false");
            });
            rotor.style.transform = "rotate(" + rot + "deg)";
            bars.forEach(function (b) { b.classList.toggle("is-active", Number(b.dataset.index) === active); });
            panels.forEach(function (p, i) {
                p.classList.toggle("is-active", i === active);
                p.setAttribute("aria-hidden", i === active ? "false" : "true");
            });
        }

        function goTo(i) {
            // shortest turn that brings icon i to 3 o'clock (angle 0)
            let d = -((i * STEP + rot) % 360);
            if (d > 180) d -= 360;
            if (d <= -180) d += 360;
            rot += d;
            active = i;
            render();
        }

        function next() { goTo((active - 1 + N) % N); }

        function setPlaying(value) {
            playing = value;
            clearInterval(timer);
            if (playing) timer = setInterval(next, INTERVAL);
            toggle.classList.toggle("is-paused", !playing);
            toggle.setAttribute("aria-label", playing ? "Pause animation" : "Play animation");
        }

        icons.forEach(function (el, i) {
            el.addEventListener("click", function () {
                setPlaying(false);   // someone chose an icon: stay put so they can read
                goTo(i);
            });
        });
        bars.forEach(function (b) {
            b.addEventListener("click", function () {
                setPlaying(false);
                goTo(Number(b.dataset.index));
            });
        });
        toggle.addEventListener("click", function () { setPlaying(!playing); });

        render();
        requestAnimationFrame(function () { wheel.classList.add("ready"); });  // enable transitions after first paint
        setPlaying(playing);
    })();
</script>
